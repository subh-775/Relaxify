{
  "rules": {
    ".read": false,
    ".write": false,
    "jams": {
      "$code": {
        ".read": "$code.matches(/^[A-HJ-NP-Z2-9]{6}$/)",
        ".write": "$code.matches(/^[A-HJ-NP-Z2-9]{6}$/)",
        ".validate": "newData.hasChildren(['expiresAt'])",
        "expiresAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 21660000"
        },
        "members": {
          "$id": {
            ".validate": "$id.matches(/^[A-HJ-NP-Z2-9]{6}$/) && newData.hasChildren(['seen'])",
            "name": {".validate": "newData.isString() && newData.val().length <= 24"},
            "seen": {".validate": "newData.isNumber()"},
            "$other": {".validate": false}
          }
        },
        "now": {
          ".validate": "newData.hasChildren(['track', 'pos', 'playing', 'at', 'by', 'seq'])",
          "track": {".validate": "newData.hasChild('title')"},
          "next": {".validate": "newData.hasChild('title')"},
          "pos": {".validate": "newData.isNumber()"},
          "playing": {".validate": "newData.isBoolean()"},
          "at": {".validate": "newData.isNumber()"},
          "by": {".validate": "newData.isString() && newData.val().length <= 12"},
          "seq": {".validate": "newData.isNumber()"},
          "$other": {".validate": false}
        },
        "queue": {
          "$key": {
            ".validate": "newData.hasChildren(['track', 'by'])",
            "track": {".validate": "newData.hasChild('title')"},
            "by": {".validate": "newData.isString() && newData.val().length <= 24"},
            "$other": {".validate": false}
          }
        },
        "$other": {".validate": false}
      }
    },
    "shared": {
      "$code": {
        ".validate": "$code.matches(/^[A-HJ-NP-Z2-9]{6}$/)",
        "key": {
          ".write": "!data.exists()",
          ".validate": "newData.isString() && newData.val().length >= 32 && newData.val().length <= 64"
        },
        "proof": {
          ".write": "newData.isString() && newData.val().beginsWith((data.parent().child('key').exists() ? data.parent().child('key').val() : newData.parent().child('key').val()) + ':') && newData.val() !== data.val()",
          ".validate": "newData.isString()"
        },
        "data": {
          ".read": true,
          ".write": "newData.parent().child('proof').val() !== data.parent().child('proof').val() && newData.parent().child('proof').val().beginsWith((data.parent().child('key').exists() ? data.parent().child('key').val() : newData.parent().child('key').val()) + ':')",
          ".validate": "newData.hasChildren(['name', 'by', 'v'])",
          "name": {".validate": "newData.isString() && newData.val().length <= 100"},
          "by": {".validate": "newData.isString() && newData.val().length <= 24"},
          "v": {".validate": "newData.isNumber()"},
          "tracks": {
            "$i": {".validate": "$i.matches(/^[0-9]{1,3}$/) && newData.child('title').isString()"}
          },
          "$other": {".validate": false}
        },
        "$other": {".validate": false}
      }
    }
  }
}
